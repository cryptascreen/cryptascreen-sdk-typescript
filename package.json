{
  "name": "@cryptascreen/sdk",
  "version": "0.3.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptascreen/cryptascreen-sdk-typescript.git"
  },
  "homepage": "https://github.com/cryptascreen/cryptascreen-sdk-typescript#readme",
  "bugs": {
    "url": "https://github.com/cryptascreen/cryptascreen-sdk-typescript/issues"
  },
  "description": "Type-safe TypeScript client for the CryptaScreen REST API",
  "author": "CryptaScreen <support@cryptacount.com>",
  "maintainers": [
    {
      "name": "CryptaScreen",
      "email": "support@cryptacount.com"
    }
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "axios-mock-adapter": "^2.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "cryptascreen",
    "compliance",
    "screening",
    "sanctions",
    "crypto",
    "aml",
    "kyc"
  ],
  "license": "MIT",
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
